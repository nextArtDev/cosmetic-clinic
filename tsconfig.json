{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@/auth": ["./lib/auth"],
      "@/generated/prisma": ["./lib/generated/prisma"],
      "@/generated/prisma/*": ["./lib/generated/prisma/*"],
      "@/lib/actions/dashboard/booking/*": ["./lib/actions/dashboard/booking/*"],
      "@/lib/actions/dashboard/*": [
        "./app/(dashboard)/dashboard/lib/actions/*",
        "./lib/actions/dashboard/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "components/Home/body-carousel"]
}
